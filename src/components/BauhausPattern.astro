---
interface Props {
  color?: string;
  opacity?: number;
  class?: string;
}
const { color = 'currentColor', opacity = 1, class: className = '' } = Astro.props;
---

<!--
  Bauhaus / Constructivist geometric grid.
  Inspired by Bauhaus spatial studies: strict orthogonal grid,
  circles at intersections, partial compass arcs.
  Tile size: 100×100 units.
-->
<svg
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
  class={`pointer-events-none select-none ${className}`}
  width="100%"
  height="100%"
>
  <defs>
    <pattern id="bauhaus" x="0" y="0" width="100" height="100" patternUnits="userSpaceOnUse">
      <!-- ── Primary grid ── -->
      <line
        x1="0"
        y1="50"
        x2="100"
        y2="50"
        stroke={color}
        stroke-width="0.6"
        opacity={opacity * 0.18}></line>
      <line
        x1="50"
        y1="0"
        x2="50"
        y2="100"
        stroke={color}
        stroke-width="0.6"
        opacity={opacity * 0.18}></line>

      <!-- ── Secondary grid ── -->
      <line
        x1="0"
        y1="25"
        x2="100"
        y2="25"
        stroke={color}
        stroke-width="0.3"
        opacity={opacity * 0.1}></line>
      <line
        x1="0"
        y1="75"
        x2="100"
        y2="75"
        stroke={color}
        stroke-width="0.3"
        opacity={opacity * 0.1}></line>
      <line
        x1="25"
        y1="0"
        x2="25"
        y2="100"
        stroke={color}
        stroke-width="0.3"
        opacity={opacity * 0.1}></line>
      <line
        x1="75"
        y1="0"
        x2="75"
        y2="100"
        stroke={color}
        stroke-width="0.3"
        opacity={opacity * 0.1}></line>

      <!-- ── Centre circle (compass / dial motif) ── -->
      <circle
        cx="50"
        cy="50"
        r="18"
        fill="none"
        stroke={color}
        stroke-width="0.6"
        opacity={opacity * 0.2}></circle>
      <circle
        cx="50"
        cy="50"
        r="6"
        fill="none"
        stroke={color}
        stroke-width="0.5"
        opacity={opacity * 0.18}></circle>
      <circle cx="50" cy="50" r="1.5" fill={color} opacity={opacity * 0.22}></circle>

      <!-- ── Grid intersection dots ── -->
      <circle cx="25" cy="25" r="1.2" fill={color} opacity={opacity * 0.16}></circle>
      <circle cx="75" cy="25" r="1.2" fill={color} opacity={opacity * 0.16}></circle>
      <circle cx="25" cy="75" r="1.2" fill={color} opacity={opacity * 0.16}></circle>
      <circle cx="75" cy="75" r="1.2" fill={color} opacity={opacity * 0.16}></circle>
      <circle cx="50" cy="25" r="1.2" fill={color} opacity={opacity * 0.12}></circle>
      <circle cx="50" cy="75" r="1.2" fill={color} opacity={opacity * 0.12}></circle>
      <circle cx="25" cy="50" r="1.2" fill={color} opacity={opacity * 0.12}></circle>
      <circle cx="75" cy="50" r="1.2" fill={color} opacity={opacity * 0.12}></circle>

      <!-- ── Tile-corner partial arcs (quarter circles, Bauhaus spatial motif) ── -->
      <path
        d="M 0,30 A 30,30 0 0,1 30,0"
        fill="none"
        stroke={color}
        stroke-width="0.4"
        opacity={opacity * 0.12}></path>
      <path
        d="M 100,30 A 30,30 0 0,0 70,0"
        fill="none"
        stroke={color}
        stroke-width="0.4"
        opacity={opacity * 0.12}></path>
      <path
        d="M 0,70 A 30,30 0 0,0 30,100"
        fill="none"
        stroke={color}
        stroke-width="0.4"
        opacity={opacity * 0.12}></path>
      <path
        d="M 100,70 A 30,30 0 0,1 70,100"
        fill="none"
        stroke={color}
        stroke-width="0.4"
        opacity={opacity * 0.12}></path>
    </pattern>
  </defs>
  <rect width="100%" height="100%" fill="url(#bauhaus)"></rect>
</svg>
