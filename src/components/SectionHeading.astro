---
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="mb-3 text-xs uppercase tracking-[0.35em] text-clay">{eyebrow}</p>}
  <h2 class="text-balance">{title}</h2>
  {description && <p class="mt-4 text-base leading-7 text-zinc-700">{description}</p>}
</div>
