---
import type { Translation } from '../../types';
interface Props {
  t: Translation;
}
const { t } = Astro.props;
---

<!-- Slide 3: Where to stay -->
<section
  class="swiper-slide jerez-slide flex h-full w-full shrink-0 flex-col justify-start px-8 py-4 md:px-16"
  data-horizontal-panel
  aria-label={t.jerez.stay.eyebrow}
>
  <div class="mx-auto w-full max-w-5xl">
    <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/85">
      {t.jerez.stay.eyebrow}
    </p>
    <h2
      class="mt-4 font-display text-[clamp(2.4rem,5vw,4.6rem)] font-light leading-none tracking-tight text-ink"
    >
      {t.jerez.stay.title}
    </h2>
    <p class="mt-3 max-w-4xl font-sans text-sm leading-6 text-ink/85">{t.jerez.stay.intro}</p>

    <aside
      id="stay-transport-note"
      role="note"
      aria-labelledby="stay-transport-heading"
      class="mt-3 flex flex-col gap-1 rounded-lg border border-clay/25 border-l-4 border-l-clay bg-sand/75 px-3 py-2 sm:flex-row sm:items-center sm:gap-4"
    >
      <h3
        id="stay-transport-heading"
        class="shrink-0 font-sans text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-ink"
      >
        {t.jerez.stay.transportTitle}
      </h3>
      <p class="font-sans text-sm leading-5 text-ink/90">{t.jerez.stay.transportNote}</p>
    </aside>

    <ul class="mt-3 grid gap-3 md:grid-cols-2">
      {
        t.jerez.stay.accommodations.map((accommodation) => (
          <li
            data-stay-card={accommodation.id}
            class="flex h-full flex-col rounded-2xl border border-clay/20 bg-white/70 p-4 shadow-soft"
          >
            <p class="font-sans text-[0.62rem] uppercase tracking-[0.25em] text-ink/75">
              {accommodation.location}
            </p>
            <h3 class="mt-1 font-display text-2xl font-medium leading-tight text-ink">
              {accommodation.name}
            </h3>
            <div class="mt-3 space-y-1.5">
              {accommodation.details.map((detail) => (
                <p class="border-l-2 border-clay/50 pl-3 font-sans text-sm leading-5 text-ink/90">
                  {detail}
                </p>
              ))}
            </div>
            <div class="mt-auto flex flex-wrap gap-2 pt-4">
              {accommodation.links.map((link) => (
                <a
                  href={link.url}
                  target={link.url.startsWith('http') ? '_blank' : undefined}
                  rel={link.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                  class="inline-flex min-h-10 items-center rounded-full border border-clay/40 bg-paper/75 px-4 py-2 font-sans text-sm font-medium text-ink transition hover:bg-sand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay focus-visible:ring-offset-2"
                >
                  {link.label}
                </a>
              ))}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
