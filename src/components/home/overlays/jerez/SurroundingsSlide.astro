---
import type { Translation } from '../../types';
interface Props {
  t: Translation;
}
const { t } = Astro.props;
---

<!-- Slide 4: Surroundings -->
<section
  class="swiper-slide jerez-slide flex h-full w-full shrink-0 flex-col justify-start px-8 py-8 md:px-16"
  data-horizontal-panel
  aria-label={t.jerez.surroundings.eyebrow}
>
  <div class="mx-auto w-full max-w-5xl">
    <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/85">
      {t.jerez.surroundings.eyebrow}
    </p>
    <h2
      class="mt-4 font-display text-[clamp(2.4rem,5vw,4.6rem)] font-light leading-none tracking-tight text-ink"
    >
      {t.jerez.surroundings.title}
    </h2>
    <div class="mt-7 grid gap-8 md:grid-cols-[0.95fr_1.05fr]">
      <div class="rounded-2xl border border-clay/15 bg-white/60 p-5 shadow-soft">
        <p class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-ink/90">
          {t.jerez.surroundings.eventsTitle}
        </p>
        <ul class="mt-3 space-y-3">
          {
            t.jerez.surroundings.events.map((event) => (
              <li class="border-l-2 border-clay/50 pl-3">
                <p class="font-sans text-sm font-medium text-ink">{event.name}</p>
                <p class="mt-0.5 font-sans text-xs font-semibold uppercase tracking-[0.12em] text-clay">
                  {event.date}
                </p>
                <p class="mt-1 font-sans text-sm leading-5 text-ink/85">{event.details}</p>
              </li>
            ))
          }
        </ul>

        <div class="mt-5 border-t border-clay/15 pt-4">
          <p class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-ink/90">
            {t.jerez.surroundings.placesTitle}
          </p>
          <ul class="mt-3 space-y-2">
            {
              t.jerez.surroundings.places.map((place) => (
                <li class="flex items-start gap-3 font-sans text-sm leading-5 text-ink/85">
                  <span class="mt-1.5 inline-block h-1.5 w-1.5 shrink-0 rounded-full bg-clay/60" />
                  <span>
                    <strong class="font-medium text-ink">{place.name}:</strong> {place.details}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <div class="w-full overflow-hidden rounded-2xl shadow-soft" style="height: 320px;">
          <div
            id="jerez-surroundings-map"
            data-jerez-lat={t.jerez.surroundings.map.jerezLat}
            data-jerez-lng={t.jerez.surroundings.map.jerezLng}
            data-sevilla-lat={t.jerez.surroundings.map.sevillaLat}
            data-sevilla-lng={t.jerez.surroundings.map.sevillaLng}
            data-sevilla-drive={t.jerez.surroundings.map.sevillaDrive}
            data-puerto-lat={t.jerez.surroundings.map.puertoLat}
            data-puerto-lng={t.jerez.surroundings.map.puertoLng}
            data-puerto-drive={t.jerez.surroundings.map.puertoDrive}
            data-sanlucar-lat={t.jerez.surroundings.map.sanlucarLat}
            data-sanlucar-lng={t.jerez.surroundings.map.sanlucarLng}
            data-sanlucar-drive={t.jerez.surroundings.map.sanlucarDrive}
            class="h-full w-full"
            aria-label={String(t.jerez.surroundings.map.label)}
          >
          </div>
        </div>
        <p class="font-sans text-sm text-ink/85">{t.jerez.surroundings.map.caption}</p>
      </div>
    </div>
  </div>
</section>
