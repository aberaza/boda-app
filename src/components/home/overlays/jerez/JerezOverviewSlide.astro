---
import type { Translation } from '../../types';
interface Props { t: Translation; }
const { t } = Astro.props;
---

      <!-- Slide 1: Overview -->
      <section class="jerez-slide flex h-full w-full shrink-0 flex-col justify-center px-8 py-24 md:px-16">
        <div class="mx-auto w-full max-w-5xl">
          <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/70">{t.jerez.eyebrow}</p>
          <h2 class="mt-4 font-display text-[clamp(2.6rem,6vw,5rem)] font-light leading-none tracking-tight text-ink">
            {t.jerez.title}<br />
            <em class="not-italic font-semibold text-clay">{t.jerez.titleSub}</em>
          </h2>
          <div class="mt-10 grid gap-10 md:grid-cols-[1.1fr_0.9fr]">
            <div class="space-y-6">
              <p class="font-sans text-base leading-7 text-ink/70">{t.jerez.overview}</p>
              <p class="font-sans text-base leading-7 text-ink/70">{t.jerez.history}</p>
              <p class="font-sans text-base leading-7 text-ink/70">{t.jerez.highlights}</p>
              <p class="font-display text-lg italic text-clay/80">{t.jerez.festivals}</p>
            </div>
            <div class="flex flex-col gap-4">
              <div class="w-full overflow-hidden rounded-2xl shadow-soft" style="height: 260px;">
                <div
                  id="jerez-city-map"
                  data-city-lat={t.jerez.map.cityLat}
                  data-city-lng={t.jerez.map.cityLng}
                  data-sevilla-lat={t.jerez.map.sevillaLat}
                  data-sevilla-lng={t.jerez.map.sevillaLng}
                  data-cadiz-lat={t.jerez.map.cadizLat}
                  data-cadiz-lng={t.jerez.map.cadizLng}
                  class="h-full w-full"
                  aria-label={t.jerez.map.label}
                />
              </div>
              <p class="font-sans text-sm text-ink/45">{t.jerez.map.caption}</p>
            </div>
          </div>
        </div>
      </section>
