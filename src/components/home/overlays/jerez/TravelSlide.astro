---
import type { Translation, FlightRoute, ProcessedRoute, RouteLink, RouteMode } from '../../types';
interface Props {
  t: Translation;
  processedRoutes: ProcessedRoute[];
}
const { t, processedRoutes } = Astro.props;

const formatDuration = (minutes: number | null) => {
  if (minutes === null) return t.jerez.gettingThere.durationPending;
  const hours = Math.floor(minutes / 60);
  const remainder = minutes % 60;
  return hours ? `${hours} h ${remainder} min` : `${remainder} min`;
};

const modeLabel = (mode: RouteMode) => {
  if (mode === 'flight') return t.jerez.gettingThere.flightMode;
  if (mode === 'train') return t.jerez.gettingThere.trainMode;
  return t.jerez.gettingThere.transferMode;
};

const optionLabel = (route: FlightRoute) => {
  if (route.label) return route.label;
  if (route.type === 'direct') return t.jerez.gettingThere.direct;
  if (route.type === 'connecting') {
    const count = route.layovers.length;
    if (count === 0) return t.jerez.gettingThere.connectionLabel;
    return `${count} ${count === 1 ? t.jerez.gettingThere.stopSingular : t.jerez.gettingThere.steps}`;
  }
  return route.segments
    .map((segment) => modeLabel(segment.mode))
    .filter((mode, index, modes) => index === 0 || mode !== modes[index - 1])
    .join(' + ');
};

const routeLinks = (route: FlightRoute): RouteLink[] => {
  if (route.links?.length) return route.links;
  if (route.bookingUrl) {
    return [
      {
        mode: route.segments.some((segment) => segment.mode === 'train') ? 'train' : 'flight',
        url: route.bookingUrl,
      },
    ];
  }
  return [];
};

const primaryLink = (route: FlightRoute) => {
  const links = routeLinks(route);
  return links.find((link) => link.mode === 'flight') ?? links[0];
};

const linkLabel = (link: RouteLink) =>
  link.mode === 'flight'
    ? t.jerez.gettingThere.flightSearchLabel
    : t.jerez.gettingThere.trainSearchLabel;

const connectionLabel = (count: number) => {
  if (count === 0) return t.jerez.gettingThere.connectionLabel;
  return `${count} ${count === 1 ? t.jerez.gettingThere.stopSingular : t.jerez.gettingThere.steps}`;
};

const generatedDate = processedRoutes.find((route) => route.generated)?.generated?.slice(0, 10);
const searchDate = processedRoutes.find((route) => route.searchDate)?.searchDate;
---

<!-- Slide 2: Getting there -->
<section
  class="swiper-slide jerez-slide flex h-full w-full shrink-0 flex-col justify-center px-8 py-24 md:px-16"
  data-horizontal-panel
  aria-label={t.jerez.gettingThere.eyebrow}
>
  <div class="mx-auto w-full max-w-5xl">
    <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/85">
      {t.jerez.gettingThere.eyebrow}
    </p>
    <h2
      class="mt-4 font-display text-[clamp(2.4rem,5vw,4.6rem)] font-light leading-none tracking-tight text-ink"
    >
      {t.jerez.gettingThere.title}
    </h2>
    <div class="mt-10 grid gap-10 md:grid-cols-[1.05fr_0.95fr]">
      <div class="space-y-6">
        <p class="font-sans text-base leading-7 text-ink/90">{t.jerez.gettingThere.airports}</p>
        {
          processedRoutes[0]?.searchDate && (
            <p class="-mt-4 font-sans text-xs italic text-ink/70">
              {t.jerez.gettingThere.priceDisclaimer} {generatedDate};{' '}
              {t.jerez.gettingThere.departureDateLabel} {searchDate}.
            </p>
          )
        }
        <div>
          <p class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-ink/90">
            {t.jerez.gettingThere.routesTitle}
          </p>
          <div class="mt-6 grid gap-4 sm:grid-cols-2">
            {
              processedRoutes.map((route) => (
                <article
                  data-route-card={route.city}
                  class="rounded-xl border border-clay/15 bg-white/40 p-4 shadow-sm"
                >
                  <button
                    type="button"
                    data-route-city={route.city}
                    data-route-index="0"
                    data-route-card-trigger
                    class="group w-full text-left"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <span class="font-sans text-sm font-medium text-ink/90 transition-colors group-hover:text-clay">
                        {route.city} → Jerez
                      </span>
                      <span class="shrink-0 text-[0.6rem] uppercase tracking-wider text-clay/85">
                        {route.hasGroundConnection
                          ? t.jerez.gettingThere.groundConnection
                          : route.isDirect
                            ? t.jerez.gettingThere.direct
                            : connectionLabel(route.steps)}
                      </span>
                    </div>
                    <p class="mt-1 font-sans text-[0.55rem] uppercase tracking-[0.12em] text-ink/65">
                      {t.jerez.gettingThere.originAirportLabel}: {route.airport}
                    </p>
                    <div class="mt-3 grid grid-cols-2 gap-2 border-t border-clay/10 pt-3">
                      <div>
                        <p class="text-[0.55rem] uppercase tracking-wider text-ink/85">
                          {t.jerez.gettingThere.fastest}
                        </p>
                        <p class="mt-0.5 font-sans text-xs text-ink/85">
                          {formatDuration(route.fastestDuration)}
                        </p>
                      </div>
                      <div>
                        <p class="text-[0.55rem] uppercase tracking-wider text-ink/85">
                          {t.jerez.gettingThere.cheapest}
                        </p>
                        <p class="mt-0.5 font-sans text-xs text-ink/85">
                          {route.cheapestPrice === null
                            ? t.jerez.gettingThere.pricePending
                            : `${route.cheapestPrice}€`}
                        </p>
                      </div>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                      {route.airlines.map((airline) => (
                        <div class="group/logo relative flex items-center gap-1.5 rounded border border-clay/15 bg-white/80 px-1.5 py-0.5 shadow-sm">
                          {airline.logo ? (
                            <img
                              src={airline.logo}
                              alt={airline.name}
                              class="h-3 w-auto object-contain grayscale transition-all group-hover/logo:grayscale-0"
                            />
                          ) : (
                            <span class="font-sans text-[0.55rem] text-clay/85">
                              {airline.name}
                            </span>
                          )}
                          <span class="absolute -top-6 left-1/2 z-10 -translate-x-1/2 whitespace-nowrap rounded bg-ink px-1.5 py-0.5 text-[0.5rem] text-white opacity-0 transition-opacity group-hover/logo:opacity-100">
                            {airline.name}
                          </span>
                        </div>
                      ))}
                    </div>
                  </button>

                  <details class="mt-3 border-t border-clay/10 pt-2">
                    <summary class="cursor-pointer font-sans text-xs font-medium text-clay hover:text-ink">
                      {t.jerez.gettingThere.combinationsLabel} ({route.routes.length})
                    </summary>
                    <ol class="mt-3 space-y-3">
                      {route.routes.map((option, optionIndex) => (
                        <li
                          data-route-option={optionIndex}
                          class="rounded-lg border border-clay/10 bg-paper/70 p-3 transition hover:border-clay/35 hover:bg-white/70"
                        >
                          {primaryLink(option) ? (
                            <a
                              href={primaryLink(option)?.url}
                              target="_blank"
                              rel="noopener noreferrer"
                              data-route-search-link
                              class="block rounded-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay"
                              aria-label={`${t.jerez.gettingThere.openSearchLabel}: ${optionLabel(option)}`}
                            >
                              <div class="flex items-start justify-between gap-2">
                                <div class="flex flex-wrap gap-1.5">
                                  {option.segments
                                    .map((segment) => modeLabel(segment.mode))
                                    .filter(
                                      (mode, index, modes) =>
                                        index === 0 || mode !== modes[index - 1],
                                    )
                                    .map((mode, modeIndex) => (
                                      <span class="inline-flex items-center gap-1 font-sans text-xs font-medium text-ink">
                                        {modeIndex > 0 && <span aria-hidden="true">+</span>}
                                        {mode}
                                      </span>
                                    ))}
                                </div>
                                {option.price !== null && (
                                  <span class="shrink-0 font-sans text-xs font-semibold text-ink">
                                    {option.price}€
                                  </span>
                                )}
                              </div>
                              <p class="mt-1 font-sans text-xs font-semibold text-ink">
                                {optionLabel(option)}
                              </p>
                              <p class="mt-1 font-sans text-[0.65rem] text-ink/75">
                                {t.jerez.gettingThere.totalDurationLabel}:{' '}
                                {formatDuration(option.totalDuration)}
                              </p>

                              <ol class="mt-2 space-y-1.5">
                                {option.segments.map((segment) => (
                                  <li class="font-sans text-xs leading-5 text-ink/85">
                                    <span class="font-medium text-ink">
                                      {segment.from.city} → {segment.to.city}
                                    </span>
                                    {segment.airline && <span> · {segment.airline}</span>}
                                    {segment.operator && <span> · {segment.operator}</span>}
                                  </li>
                                ))}
                              </ol>
                              <span class="mt-3 inline-flex font-sans text-xs font-medium text-clay underline underline-offset-4">
                                {linkLabel(primaryLink(option)!)}
                              </span>
                            </a>
                          ) : null}

                          {option.layovers.length > 0 && (
                            <p class="mt-2 font-sans text-xs leading-5 text-ink/80">
                              {t.jerez.gettingThere.layoversLabel}:{' '}
                              {option.layovers.map((layover) => layover.city).join(' · ')}
                            </p>
                          )}

                          {option.priceScope === 'flight-only' && (
                            <p class="mt-2 font-sans text-[0.65rem] leading-5 text-ink/70">
                              {t.jerez.gettingThere.flightPriceOnlyNote}
                            </p>
                          )}
                          {option.priceScope === 'unknown' && (
                            <p class="mt-2 font-sans text-[0.65rem] leading-5 text-ink/70">
                              {t.jerez.gettingThere.trainPricePending}
                            </p>
                          )}
                          {option.segments.some((segment) => segment.mode === 'train') && (
                            <p class="mt-2 font-sans text-[0.65rem] leading-5 text-ink/70">
                              {t.jerez.gettingThere.trainConnectionNote}
                            </p>
                          )}
                          {routeLinks(option).length > 1 && (
                            <div class="mt-2 flex flex-wrap gap-x-3 gap-y-1">
                              {routeLinks(option)
                                .filter((link) => link.url !== primaryLink(option)?.url)
                                .map((link) => (
                                  <a
                                    href={link.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="inline-flex font-sans text-xs text-clay underline-offset-4 hover:underline"
                                  >
                                    {linkLabel(link)}
                                  </a>
                                ))}
                            </div>
                          )}

                          <button
                            type="button"
                            data-route-city={route.city}
                            data-route-index={optionIndex}
                            aria-label={`${t.jerez.gettingThere.showOnMapLabel}: ${optionLabel(option)}`}
                            class="mt-3 block rounded-full border border-clay/40 px-3 py-1.5 font-sans text-xs font-medium text-ink transition hover:bg-sand focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-clay"
                          >
                            {t.jerez.gettingThere.showOnMapLabel}
                          </button>
                        </li>
                      ))}
                    </ol>
                  </details>
                </article>
              ))
            }
          </div>
        </div>
      </div>
      <div class="flex flex-col gap-4">
        <div class="w-full overflow-hidden rounded-2xl shadow-soft" style="height: 420px;">
          <div
            id="jerez-routes-map"
            data-jerez-lat={t.jerez.routesMap.jerezLat}
            data-jerez-lng={t.jerez.routesMap.jerezLng}
            data-barcelona-lat={t.jerez.routesMap.barcelonaLat}
            data-barcelona-lng={t.jerez.routesMap.barcelonaLng}
            data-paris-lat={t.jerez.routesMap.parisLat}
            data-paris-lng={t.jerez.routesMap.parisLng}
            data-pamplona-lat={t.jerez.routesMap.pamplonaLat}
            data-pamplona-lng={t.jerez.routesMap.pamplonaLng}
            data-madrid-lat={t.jerez.routesMap.madridLat}
            data-madrid-lng={t.jerez.routesMap.madridLng}
            data-granada-lat={t.jerez.routesMap.granadaLat}
            data-granada-lng={t.jerez.routesMap.granadaLng}
            data-valencia-lat={t.jerez.routesMap.valenciaLat}
            data-valencia-lng={t.jerez.routesMap.valenciaLng}
            data-aviles-lat={t.jerez.routesMap.avilesLat}
            data-aviles-lng={t.jerez.routesMap.avilesLng}
            class="h-full w-full"
            aria-label={String(t.jerez.routesMap.label)}
          >
          </div>
        </div>
        <div class="flex flex-wrap gap-x-4 gap-y-1 px-1 font-sans text-[0.65rem] text-ink/75">
          <span class="inline-flex items-center gap-1.5">
            <span class="h-0.5 w-5 bg-clay" aria-hidden="true"></span>
            {t.jerez.gettingThere.flightMode}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-5 border-t-2 border-dashed border-emerald-700" aria-hidden="true"></span>
            {t.jerez.gettingThere.trainMode}
          </span>
          <span class="inline-flex items-center gap-1.5">
            <span class="w-5 border-t-2 border-dotted border-stone-500" aria-hidden="true"></span>
            {t.jerez.gettingThere.transferMode}
          </span>
        </div>
        <p class="font-sans text-sm text-ink/85">{t.jerez.routesMap.caption}</p>
      </div>
    </div>
  </div>
</section>
