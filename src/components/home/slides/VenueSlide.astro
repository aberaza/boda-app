---
import BauhausPattern from '../../BauhausPattern.astro';
import GeoPattern from '../../GeoPattern.astro';
import HorizontalCarousel from '../HorizontalCarousel.astro';
import JerezOverviewSlide from '../overlays/jerez/JerezOverviewSlide.astro';
import TravelSlide from '../overlays/jerez/TravelSlide.astro';
import AccommodationSlide from '../overlays/jerez/AccommodationSlide.astro';
import SurroundingsSlide from '../overlays/jerez/SurroundingsSlide.astro';
import { event, images } from '../../../config/content';
import { patterns, slideBg } from '../../../config/theme';
import { getLang } from '../../../i18n';
import { horizontalCopy } from '../../../i18n/horizontal';
import type { Translation, ProcessedRoute } from '../types';
import { mAlmohade, mBauhaus } from '../view';

interface Props {
  t: Translation;
  processedRoutes: ProcessedRoute[];
}
const { t, processedRoutes } = Astro.props;
const horizontal = horizontalCopy[getLang(Astro.url)];
const panelLabels = [
  t.finca.eyebrow,
  t.jerez.eyebrow,
  t.jerez.gettingThere.eyebrow,
  t.jerez.stay.eyebrow,
  t.jerez.surroundings.eyebrow,
];
---

<section
  aria-label={t.nav.finca}
  class="slide absolute inset-0 overflow-hidden"
  style={`background: ${slideBg.finca};`}
>
  <div class="pointer-events-none absolute inset-0" style={mBauhaus}>
    <BauhausPattern
      color={patterns.bauhaus.color}
      opacity={patterns.bauhaus.opacity}
      class="h-full w-full"
    />
  </div>
  <div class="pointer-events-none absolute inset-0" style={mAlmohade}>
    <GeoPattern
      color={patterns.almohade.color}
      opacity={patterns.almohade.opacity}
      class="h-full w-full"
    />
  </div>
  <HorizontalCarousel
    id="venue-carousel"
    label={t.nav.finca}
    labels={panelLabels}
    copy={horizontal}
  >
    <article class="swiper-slide" data-horizontal-panel aria-label={panelLabels[0]}>
      <div class="horizontal-panel-body grid items-center gap-8 md:grid-cols-2">
        <div class="flex flex-col justify-center">
          <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-ink/85">
            {t.finca.eyebrow}
          </p>
          <h2
            class="mt-5 font-sans text-[clamp(2.2rem,5vw,4rem)] font-light leading-tight tracking-tight text-ink"
          >
            {event.venue.split(' ')[0]}<br />
            <strong class="font-medium text-clay"
              >{event.venue.split(' ').slice(1).join(' ')}</strong
            >
          </h2>
          <p class="mt-6 max-w-xs font-sans text-base leading-7 text-ink/85">
            {t.event.venueDescription}
          </p>
          <a
            href={event.venueUrl}
            target="_blank"
            rel="noopener"
            class="mt-6 self-start text-sm text-clay underline underline-offset-4"
            >{t.finca.linkLabel}</a
          >
          <p class="mt-6 text-base text-ink/90">{event.city}, {event.region}</p>
          <button
            type="button"
            data-horizontal-next
            class="mt-5 self-start rounded-full border border-clay/60 bg-paper/80 px-5 py-3 text-sm text-ink hover:bg-sand"
            >{horizontal.discover}</button
          >
        </div>
        <div class="flex flex-col items-center justify-center">
          <div
            class="w-full max-w-sm overflow-hidden rounded-[1.5rem] shadow-soft"
            style="aspect-ratio: 4/3;"
          >
            <img
              src={images.finca}
              alt={t.finca.photoAlt}
              class="h-full w-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <p class="mt-5 text-center font-display text-base italic text-ink/85">
            {t.finca.photoCaption}
          </p>
        </div>
      </div>
    </article>
    <JerezOverviewSlide t={t} />
    <TravelSlide t={t} processedRoutes={processedRoutes} />
    <AccommodationSlide t={t} />
    <SurroundingsSlide t={t} />
  </HorizontalCarousel>
</section>
