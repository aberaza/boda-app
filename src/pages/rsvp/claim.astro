---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getLang } from '../../i18n';
import { getRsvpTranslation } from '../../i18n/rsvp';
import { PRIVATE_HEADERS } from '../../server/rsvp/http';
Astro.response.headers.set('Cache-Control', PRIVATE_HEADERS['Cache-Control']);
Astro.response.headers.set('Referrer-Policy', PRIVATE_HEADERS['Referrer-Policy']);
Astro.response.headers.set('X-Robots-Tag', PRIVATE_HEADERS['X-Robots-Tag']);
const lang = getLang(Astro.url);
const t = getRsvpTranslation(lang);
const code = Astro.url.searchParams.get('code') ?? '';
---

<BaseLayout title={`${t.claimTitle} | Aritz & Sandra`} description={t.claimIntro} lang={lang}>
  <main class="mx-auto min-h-screen max-w-2xl px-5 py-10 md:py-16">
    <section class="rounded-[2rem] border border-black/10 bg-white/85 p-6 shadow-soft md:p-10">
      <p class="text-xs uppercase tracking-[0.35em] text-clay">RSVP</p>
      <h1 class="mt-3 font-display text-4xl text-ink md:text-5xl">{t.claimTitle}</h1>
      <p class="mt-4 leading-7 text-ink/65">{t.claimIntro}</p>
      <form
        data-claim-form
        class="mt-8 grid gap-5"
        data-saving={t.claimSaving}
        data-error={t.saveError}
      >
        <label class="flex flex-col gap-2"
          ><span class="text-sm font-medium">{t.claimCode}</span><input
            required
            name="code"
            value={code}
            minlength="24"
            maxlength="128"
            autocomplete="off"
            class="rounded-2xl border border-black/10 bg-white px-4 py-3"
          /></label
        >
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-2"
            ><span class="text-sm font-medium">{t.firstName}</span><input
              required
              name="firstName"
              maxlength="100"
              autocomplete="given-name"
              class="rounded-2xl border border-black/10 bg-white px-4 py-3"
            /></label
          >
          <label class="flex flex-col gap-2"
            ><span class="text-sm font-medium">{t.lastName}</span><input
              required
              name="lastName"
              maxlength="100"
              autocomplete="family-name"
              class="rounded-2xl border border-black/10 bg-white px-4 py-3"
            /></label
          >
        </div>
        <input type="hidden" name="locale" value={lang} />
        <p data-claim-status role="status" aria-live="polite" class="min-h-6 text-sm"></p>
        <button type="submit" class="rounded-full bg-ink px-6 py-4 text-sm font-medium text-paper"
          >{t.claimSubmit}</button
        >
      </form>
      <div data-claim-result hidden class="mt-8 rounded-3xl border border-clay/20 bg-clay/10 p-5">
        <p class="font-medium">{t.claimSuccess}</p>
        <input
          readonly
          data-private-url
          class="mt-4 w-full rounded-xl border border-black/10 bg-white px-3 py-2 text-sm"
        />
        <div class="mt-4 flex flex-wrap gap-3">
          <button
            type="button"
            data-copy-url
            class="rounded-full border border-ink/20 px-5 py-3 text-sm">{t.claimCopy}</button
          >
          <a data-continue-url class="rounded-full bg-ink px-5 py-3 text-sm text-paper"
            >{t.claimContinue}</a
          >
        </div>
      </div>
    </section>
  </main>
  <script>
    import '../../scripts/rsvp-claim';
  </script>
</BaseLayout>
