---
import BaseLayout from '../layouts/BaseLayout.astro';
import GeoPattern from '../components/GeoPattern.astro';
import BauhausPattern from '../components/BauhausPattern.astro';
import { couple, event, images, names } from '../config/content';
import { getLang, getT, langUrl, locales } from '../i18n';
import { patterns, masks, overlays, slideBg, animation } from '../config/theme';
import '../styles/page-home.css';

import flightRoutes from '../data/flight-routes.json';

const lang = getLang(Astro.url);
const t    = getT(lang);
const copy = t; // alias so template references stay the same shape
const slideNav = [
  { key: 'inicio', label: t.nav.hero },
  { key: 'cuando', label: t.nav.cuando },
  { key: 'donde', label: t.nav.finca },
  { key: 'info', label: t.nav.pronto },
] as const;
const NUM_SLIDES = slideNav.length;

// --- Process flight routes for Slide 2 ---
const suggestedCities = ['Barcelona', 'París', 'Pamplona', 'Madrid', 'Granada', 'Valencia'];
const processedRoutes = suggestedCities.map(cityName => {
  const origin = flightRoutes.origins.find(o => o.city === cityName);
  if (!origin) return null;

  // Shortest route by steps (segments count)
  const shortestBySteps = origin.routes.reduce((min, r) =>
    r.segments.length < min.segments.length ? r : min
  , origin.routes[0]);

  // Fastest route (totalDuration)
  const fastest = origin.routes.reduce((min, r) =>
    r.totalDuration < min.totalDuration ? r : min
  , origin.routes[0]);

  // Cheapest route (price)
  const cheapest = origin.routes.reduce((min, r) =>
    r.price < min.price ? r : min
  , origin.routes[0]);

  // Average price for the "shortest by steps" category (if multiple)
  // But usually we just want stats from these.
  const sameStepsRoutes = origin.routes.filter(r => r.segments.length === shortestBySteps.segments.length);
  const avgPriceShortest = Math.round(sameStepsRoutes.reduce((sum, r) => sum + r.price, 0) / sameStepsRoutes.length);

  return {
    city: cityName,
    steps: shortestBySteps.segments.length,
    isDirect: shortestBySteps.type === 'direct',
    fastestDuration: fastest.totalDuration,
    cheapestPrice: cheapest.price,
    avgPriceShortest: avgPriceShortest,
    airlines: Array.from(new Map(origin.routes.flatMap(r => r.segments.map(s => [s.airline, s.logo]))).entries()).map(([name, logo]) => ({ name, logo })),
  };
}).filter(Boolean);

// Pre-build webkit-prefixed mask style strings
const mBauhaus  = `mask-image: ${masks.bauhaus}; -webkit-mask-image: ${masks.bauhaus};`;
const mAlmohade = `mask-image: ${masks.almohade}; -webkit-mask-image: ${masks.almohade};`;
// Narrower masks for the last slide (symmetric fade from edges)
const narrowMask = (dir: 'right' | 'left') => {
  const m = `linear-gradient(to ${dir}, rgba(0,0,0,0.5) 0%, transparent 45%)`;
  return `mask-image: ${m}; -webkit-mask-image: ${m};`;
};
---

<BaseLayout title={t.meta.title} description={t.meta.description}>

  <!-- ── Language switcher ───────────────────────────────────────────── -->
  <nav class="fixed top-4 right-5 z-50 flex items-center gap-2">
    {locales.map((l) => (
      <a
        href={langUrl(Astro.url, l)}
        class={[
          'font-sans text-[0.6rem] uppercase tracking-[0.35em] px-2 py-1 rounded transition-colors',
          lang === l
            ? 'bg-clay/20 text-clay'
            : 'text-ink/40 hover:text-ink/70',
        ].join(' ')}
        aria-current={lang === l ? 'true' : undefined}
      >{l}</a>
    ))}
  </nav>

  <!-- ── Section dot navigation ────────────────────────────────────────────
       Fixed right-center. Each button targets a slide index.
       Active state set by JS via [data-active] attribute.
  ─────────────────────────────────────────────────────────────────── -->
  <nav
    id="slide-nav"
    aria-label="Section navigation"
    class="fixed right-5 top-1/2 z-50 flex -translate-y-1/2 flex-col items-end gap-[18px]"
  >
    {slideNav.map(({ key, label }, index) => (
      <button
        data-slide-btn={index}
        data-slide-key={key}
        aria-label={label}
        class="group flex items-center gap-2.5 outline-none"
      >
        {/* label — slides in from right on hover */}
        <span class="pointer-events-none translate-x-1 font-sans text-[0.52rem] uppercase tracking-[0.4em] text-ink/0 opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100 group-hover:text-ink/50 group-[[data-active]]:text-clay/60">
          {label}
        </span>
        {/* dot */}
        <span class="block h-[7px] w-[7px] rounded-full bg-ink/20 ring-1 ring-transparent transition-all duration-200 group-hover:bg-ink/50 group-hover:scale-110 group-[[data-active]]:bg-clay group-[[data-active]]:ring-clay/30 group-[[data-active]]:scale-125" />
      </button>
    ))}
  </nav>
    ────────────
    #scroll-driver  – tall invisible div; its scroll range drives GSAP
    #slides-wrap    – position:fixed, inset-0; contains all slides
    .slide          – position:absolute, inset-0; stacked, opacity animated by GSAP

    PATTERN FUSION
    ──────────────
    Both patterns span full width.
    Bauhaus  – masked fading right  (invisible toward right edge)
    Almohade – masked fading left   (invisible toward left edge)
    They overlap in the centre, creating a natural visual amalgam.
    All values controlled via src/config/theme.ts
  -->

  <!-- Tall scroll driver (hidden on mobile snap mode) -->
  <div id="scroll-driver" style={`height: calc(${NUM_SLIDES} * 100vh);`}></div>

  <!-- Fixed slides container -->
  <div id="slides-wrap" class="fixed inset-0 overflow-hidden bg-paper">


    <!-- ═══════════════════════════════════════════════
         SLIDE 1 · HERO
    ═══════════════════════════════════════════════ -->
    <section class="slide absolute inset-0 flex items-center justify-center overflow-hidden" style={`background: ${slideBg.hero};`}>

      <!-- B&W hands photo, desaturated + warm parchment wash -->
      <div
        id="hero-photo"
        class="absolute inset-0"
        style={`background-image: url('${images.hero}'); background-size: cover; background-position: center 40%; filter: ${overlays.heroFilter};`}
      />
      <div id="hero-parchment" class="absolute inset-0" style={`background: ${overlays.heroParchment};`} />

      <!-- Bauhaus pattern, fades right -->
      <div id="hero-bauhaus" class="absolute inset-0" style={mBauhaus}>
        <BauhausPattern color={patterns.bauhaus.color} opacity={patterns.bauhaus.opacity} class="h-full w-full" />
      </div>

      <!-- Almohade pattern, fades left -->
      <div id="hero-almohade" class="absolute inset-0" style={mAlmohade}>
        <GeoPattern color={patterns.almohade.color} opacity={patterns.almohade.opacity} class="h-full w-full" />
      </div>

      <!-- content -->
      <div class="relative z-10 flex w-full max-w-5xl flex-col items-center px-8 text-center">

        <div id="hero-date" class="flex w-full items-center justify-center gap-6 md:gap-12">
          <span class="font-sans text-[0.65rem] uppercase tracking-[0.45em] text-ink/50">{t.event.dateShort}</span>
          <div class="h-px w-12 bg-clay/40" />
          <span class="font-display text-sm italic text-ink/50">{event.city}</span>
        </div>

        <h1 id="hero-tagline" class="mt-8 font-display text-[clamp(4rem,11vw,9rem)] font-light leading-none tracking-tight text-ink">
          {t.hero.tagline.split(' ')[0]}<br />
          <em class="not-italic font-semibold text-clay">{t.hero.tagline.split(' ').slice(1).join(' ')}</em>
        </h1>

        <div id="hero-names" class="mt-10 flex items-baseline gap-4">
          <span class="font-sans text-sm font-light uppercase tracking-[0.4em] text-ink/60">{names.display}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" class="shrink-0 text-clay" fill="currentColor">
            <polygon points="7,1 8.5,5 13,7 8.5,9 7,13 5.5,9 1,7 5.5,5" opacity="0.7"/>
          </svg>
          <span class="font-display text-xl italic text-ink/60">{names.display2}</span>
        </div>

        <div id="hero-cue" class="mt-16 flex flex-col items-center gap-3 text-ink/30">
          <div class="h-8 w-px bg-ink/20" />
<span class="font-sans text-[0.6rem] uppercase tracking-[0.4em]">{t.hero.scrollCue}</span>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         SLIDE 2 · CUÁNDO
    ═══════════════════════════════════════════════ -->
    <section class="slide absolute inset-0 flex overflow-hidden" style={`background: ${slideBg.cuando};`}>

      <!-- vineyard photo as faint bg texture -->
      <div
        class="absolute inset-0"
        style={`background-image: url('${images.cuando}'); background-size: cover; background-position: center; opacity: ${overlays.cuandoPhotoOpacity};`}
      />

      <!-- Bauhaus pattern, fades right -->
      <div class="absolute inset-0" style={mBauhaus}>
        <BauhausPattern color={patterns.bauhaus.color} opacity={patterns.bauhaus.opacity} class="h-full w-full" />
      </div>

      <!-- Almohade pattern, fades left -->
      <div class="absolute inset-0" style={mAlmohade}>
        <GeoPattern color={patterns.almohade.color} opacity={patterns.almohade.opacity} class="h-full w-full" />
      </div>

      <div class="relative z-10 grid w-full md:grid-cols-2">

        <!-- LEFT — Bauhaus: data, label, numbers -->
        <div class="flex flex-col justify-center px-10 py-16 md:px-16">
          <p class="slide-label font-sans text-[0.65rem] uppercase tracking-[0.5em] text-ink/40">{t.cuando.eyebrow}</p>
          <h2 class="slide-title mt-5 font-sans text-[clamp(2.2rem,5vw,4rem)] font-light leading-tight tracking-tight text-ink">
          {t.event.date}
          </h2>

          <dl class="slide-body mt-10 space-y-6">
            <div class="flex items-start gap-4">
              <div class="mt-1 h-px w-6 shrink-0 bg-clay/50" />
              <div>
                <dt class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-ink/35">{t.cuando.labels.ceremony}</dt>
                <dd class="mt-1 font-sans text-lg text-ink/80">{event.time}</dd>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="mt-1 h-px w-6 shrink-0 bg-clay/50" />
              <div>
                <dt class="font-sans text-[0.6rem] uppercase tracking-[0.4em] text-ink/35">{t.cuando.labels.city}</dt>
                <dd class="mt-1">
                  <button
                    data-open-overlay="jerez"
                    class="inline-flex flex-wrap items-center gap-3 font-sans text-lg text-ink/80 underline decoration-clay/40 underline-offset-4 transition-colors hover:text-ink/95"
                  >
                    <span>{event.city}, {event.region}</span>
                    <span class="rounded-full border border-clay/40 bg-clay/10 px-2.5 py-1 text-[0.5rem] uppercase tracking-[0.4em] text-clay/80 no-underline">
                      {t.jerez.openLabel}
                    </span>
                    <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" class="text-clay/70">
                      <path d="M1 11L11 1M11 1H4M11 1v7"/>
                    </svg>
                  </button>
                </dd>
              </div>
            </div>
          </dl>
        </div>

        <!-- RIGHT — Almohade: display type, poetic, ornamental -->
        <div class="slide-right flex flex-col items-start justify-center px-10 py-16 md:px-16">
          <div class="font-display text-[clamp(5rem,14vw,11rem)] font-light leading-none text-clay/20 select-none">I</div>
          <p class="mt-4 max-w-xs font-display text-[1.4rem] font-light italic leading-relaxed text-ink/55">
            &ldquo;{t.cuando.quote}&rdquo;
          </p>
          <svg class="mt-6 text-clay" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="12,2 14,9 21,12 14,15 12,22 10,15 3,12 10,9" opacity="0.45"/>
            <polygon points="12,5 13.5,9.5 18,12 13.5,14.5 12,19 10.5,14.5 6,12 10.5,9.5" fill="none" stroke="currentColor" stroke-width="0.6" opacity="0.35"/>
          </svg>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         SLIDE 3 · LA FINCA
    ═══════════════════════════════════════════════ -->
    <section class="slide absolute inset-0 flex overflow-hidden" style={`background: ${slideBg.finca};`}>

      <div class="absolute inset-0" style={mBauhaus}>
        <BauhausPattern color={patterns.bauhaus.color} opacity={patterns.bauhaus.opacity} class="h-full w-full" />
      </div>
      <div class="absolute inset-0" style={mAlmohade}>
        <GeoPattern color={patterns.almohade.color} opacity={patterns.almohade.opacity} class="h-full w-full" />
      </div>

      <div class="relative z-10 grid w-full items-center md:grid-cols-2">

        <!-- LEFT — Bauhaus: clean venue data -->
        <div class="flex flex-col justify-center px-10 py-16 md:px-16">
          <p class="slide-label font-sans text-[0.65rem] uppercase tracking-[0.5em] text-ink/40">{t.finca.eyebrow}</p>
          <h2 class="slide-title mt-5 font-sans text-[clamp(2.2rem,5vw,4rem)] font-light leading-tight tracking-tight text-ink">
            {event.venue.split(' ')[0]}<br />
            <strong class="font-medium text-clay">{event.venue.split(' ').slice(1).join(' ')}</strong>
          </h2>
          <p class="slide-body mt-6 max-w-xs font-sans text-base leading-7 text-ink/60">{t.event.venueDescription}</p>
          <a
            href={event.venueUrl}
            target="_blank"
            rel="noopener"
            class="slide-body mt-8 inline-flex items-center gap-2 self-start font-sans text-sm text-clay/80 underline-offset-4 hover:underline"
          >
            {t.finca.linkLabel}
            <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M1 11L11 1M11 1H4M11 1v7"/>
            </svg>
          </a>

          <!-- Event detail trigger -->
          <button
          id="open-finca-detail"
            data-open-overlay="finca"
            class="slide-body mt-5 inline-flex items-center gap-2 self-start rounded-full border border-clay/40 bg-clay/8 px-4 py-2 font-sans text-[0.7rem] uppercase tracking-[0.35em] text-clay transition-colors hover:bg-clay/15"
          >
            {t.eventDetail.open}
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M6 1v10M11 6H1" transform="rotate(45 6 6)"/>
              <circle cx="6" cy="6" r="5"/>
            </svg>
          </button>
        </div>

        <!-- RIGHT — Almohade: photo panel + classical text -->
        <div class="slide-right flex flex-col items-center justify-center px-10 py-16 md:px-16">
          <div class="w-full max-w-sm overflow-hidden rounded-[1.5rem] shadow-soft" style="aspect-ratio: 4/3;">
            <img
              src={images.finca}
              alt={t.finca.photoAlt}
              class="h-full w-full object-cover object-center"
              loading="lazy"
            />
          </div>
          <p class="mt-5 font-display text-base italic text-ink/45 text-center">{t.finca.photoCaption}</p>
        </div>
      </div>
    </section>


    <!-- ═══════════════════════════════════════════════
         SLIDE 4 · PRONTO MÁS
    ═══════════════════════════════════════════════ -->
    <section class="slide absolute inset-0 flex flex-col items-center justify-center overflow-hidden px-8 text-center" style={`background: ${slideBg.pronto};`}>

      <div class="absolute inset-0" style={narrowMask('right')}>
        <BauhausPattern color={patterns.bauhaus.color} opacity={0.7} class="h-full w-full" />
      </div>
      <div class="absolute inset-0" style={narrowMask('left')}>
        <GeoPattern color={patterns.almohade.color} opacity={0.7} class="h-full w-full" />
      </div>

      <div class="relative z-10 flex flex-col items-center">
        <!-- hybrid ornament: Bauhaus circle + Almohade star -->
        <svg width="48" height="48" viewBox="0 0 48 48" class="text-clay">
          <circle cx="24" cy="24" r="20" fill="none" stroke="currentColor" stroke-width="0.8" opacity="0.35" />
          <circle cx="24" cy="24" r="14" fill="none" stroke="currentColor" stroke-width="0.5" opacity="0.25" />
          <polygon points="24,10 26.5,18 34,24 26.5,30 24,38 21.5,30 14,24 21.5,18" fill="currentColor" opacity="0.4" />
        </svg>

        <p class="slide-label mt-8 font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/70">{t.pronto.eyebrow}</p>

        <h2 class="slide-title mt-5 font-display text-[clamp(2rem,5vw,3.8rem)] font-light leading-tight text-ink">
          {t.pronto.title}
        </h2>

        <div class="mt-6 flex items-center gap-4">
          <div class="h-px w-12 bg-clay/25" />
          <svg width="8" height="8" viewBox="0 0 8 8" fill="currentColor" class="text-clay opacity-40"><polygon points="4,0 5,3 8,4 5,5 4,8 3,5 0,4 3,3"/></svg>
          <div class="h-px w-12 bg-clay/25" />
        </div>

        <p class="slide-body mt-6 max-w-md font-sans text-base leading-7 text-ink/55">{t.pronto.body}</p>

        <div class="slide-body mt-10 overflow-hidden rounded-2xl shadow-soft" style="width: min(340px, 90vw); aspect-ratio: 3/2;">
          <img src={images.boda} alt={t.pronto.imgAlt} class="h-full w-full object-cover" loading="lazy" />
        </div>
      </div>
    </section>

  </div>{/* /#slides-wrap */}


  <!-- ═══════════════════════════════════════════════
       FINCA DETAIL OVERLAY
       Fixed full-screen panel; GSAP-animated in/out.
       Contains: date/time, event programme, dress code, address + themed map.
  ═══════════════════════════════════════════════ -->
  <div
    id="finca-detail"
    data-overlay-key="finca"
    class="fixed inset-0 z-[60] overflow-y-auto bg-paper"
    aria-modal="true"
    role="dialog"
    aria-label={t.finca.eyebrow}
  >
    <!-- Pattern accents -->
    <div class="pointer-events-none absolute inset-0" style={mBauhaus}>
      <BauhausPattern color={patterns.bauhaus.color} opacity={0.5} class="h-full w-full" />
    </div>
    <div class="pointer-events-none absolute inset-0" style={mAlmohade}>
      <GeoPattern color={patterns.almohade.color} opacity={0.5} class="h-full w-full" />
    </div>

    <!-- Close button -->
    <button
      id="close-finca-detail"
      data-close-overlay
      class="fixed right-5 top-5 z-10 flex items-center gap-2 font-sans text-[0.6rem] uppercase tracking-[0.35em] text-ink/40 transition-colors hover:text-ink/70"
      aria-label={t.eventDetail.close}
    >
      {t.eventDetail.close}
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M1 1l12 12M13 1L1 13"/>
      </svg>
    </button>

    <!-- Content -->
    <div class="relative z-[1] mx-auto flex min-h-screen max-w-5xl flex-col justify-center px-8 py-24 md:py-20">

      <!-- Eyebrow -->
      <p class="font-sans text-[0.65rem] uppercase tracking-[0.5em] text-clay/70">
        {t.eventDetail.eyebrow}
      </p>

      <!-- Main heading -->
      <h2 class="mt-4 font-display text-[clamp(2.6rem,6vw,5rem)] font-light leading-none tracking-tight text-ink">
        {t.eventDetail.lead}<br />
        <em class="not-italic font-semibold text-clay">{t.eventDetail.leadSub}</em>
      </h2>

      <div class="mt-12 grid gap-12 md:grid-cols-2">

        <!-- LEFT — Programme + dress code -->
        <div class="flex flex-col gap-10">

          <div>
            <p class="font-sans text-[0.6rem] uppercase tracking-[0.45em] text-ink/35">
              {t.eventDetail.scheduleTitle}
            </p>
            <dl class="mt-6 space-y-5">
              {[
                { time: t.eventDetail.s1time, label: t.eventDetail.s1label },
                { time: t.eventDetail.s2time, label: t.eventDetail.s2label },
                { time: t.eventDetail.s3time, label: t.eventDetail.s3label },
              ].map(({ time, label }) => (
                <div class="flex items-start gap-4">
                  <div class="mt-[0.6rem] h-px w-6 shrink-0 bg-clay/40" />
                  <div>
                    <dt class="font-sans text-[0.58rem] uppercase tracking-[0.4em] text-ink/35">{time}</dt>
                    <dd class="mt-0.5 font-sans text-base text-ink/80">{label}</dd>
                  </div>
                </div>
              ))}
            </dl>
          </div>

          <!-- Dress code -->
          <div class="flex items-center gap-4">
            <svg width="20" height="20" viewBox="0 0 20 20" class="shrink-0 text-clay/50" fill="currentColor">
              <polygon points="10,1 12,7 18,10 12,13 10,19 8,13 2,10 8,7" opacity="0.7"/>
            </svg>
            <div>
              <p class="font-sans text-[0.58rem] uppercase tracking-[0.4em] text-ink/35">
                {t.eventDetail.dressCodeLabel}
              </p>
              <p class="mt-0.5 font-display text-lg italic text-ink/70">
                {t.eventDetail.dressCodeValue}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-4">
            <svg width="20" height="20" viewBox="0 0 20 20" class="shrink-0 text-clay/50" fill="currentColor">
              <polygon points="10,1 12,7 18,10 12,13 10,19 8,13 2,10 8,7" opacity="0.7"/>
            </svg>
            <div>
              <p class="font-sans text-[0.58rem] uppercase tracking-[0.4em] text-ink/35">
                {t.eventDetail.adultsOnlyLabel}
              </p>
              <p class="mt-0.5 font-display text-lg italic text-ink/70">
                {t.eventDetail.adultsOnlyNote}
              </p>
            </div>
          </div>

        </div>

        <!-- RIGHT — Address + map -->
        <div class="flex flex-col gap-6">

          <div>
            <p class="font-sans text-[0.6rem] uppercase tracking-[0.45em] text-ink/35">
              {t.eventDetail.addressLabel}
            </p>
            <p class="mt-3 font-sans text-base leading-7 text-ink/75">
              {event.venue}<br />
              {event.venueAddress}
            </p>
            <a
              href={event.venueMapsUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex items-center gap-1.5 font-sans text-sm text-clay/70 underline-offset-4 hover:underline"
            >
              {t.eventDetail.mapsLabel}
              <svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M1 11L11 1M11 1H4M11 1v7"/>
              </svg>
            </a>
          </div>

          <!-- Leaflet map — initialised by client JS -->
          <div
          id="venue-map"
            data-lat={event.venueLat}
            data-lng={event.venueLng}
            data-name={event.venue}
            data-city-lat={36.68762537447789}
            data-city-lng={-6.136780790369877}
            class="w-full overflow-hidden rounded-2xl shadow-soft"
            style="height: 260px;"
            aria-label="Mapa Finca La Carreña"
          />

        </div>
      </div>
    </div>
