---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeNavigation from '../components/home/HomeNavigation.astro';
import HomeSlideshow from '../components/home/HomeSlideshow.astro';
import { getLang, getT, langUrl, locales } from '../i18n';
import { getSuggestedRoutes } from '../lib/flight-routes';
import '../styles/page-home.css';

const lang = getLang(Astro.url);
const t = getT(lang);
const slideNav = [
  { key: 'inicio', label: t.nav.hero },
  { key: 'cuando', label: t.nav.cuando },
  { key: 'evento', label: t.nav.eventDetail },
  { key: 'donde', label: t.nav.finca },
  { key: 'info', label: t.nav.pronto },
];
const localeLinks = locales.map((locale) => ({ locale, href: langUrl(Astro.url, locale) }));
const processedRoutes = getSuggestedRoutes();
const rsvpHref = lang === 'es' ? '/rsvp' : `/rsvp?lang=${lang}`;
---

<BaseLayout title={t.meta.title} description={t.meta.description} lang={lang}>
  <HomeNavigation
    lang={lang}
    keyboardHelp={t.nav.keyboardHelp}
    sectionLabel={t.nav.sectionLabel}
    localeLinks={localeLinks}
    slideNav={slideNav}
  />
  <HomeSlideshow
    t={t}
    slideCount={slideNav.length}
    rsvpHref={rsvpHref}
    processedRoutes={processedRoutes}
  />

  <script>
    import '../scripts/home';
  </script>
</BaseLayout>
