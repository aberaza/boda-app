{
  "name": "wedding",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "routes": "node scripts/build-routes.mjs",
    "routes:dry": "node scripts/build-routes.mjs --dry-run",
    "build": "astro build",
    "preview": "astro preview",
    "dev": "astro dev",
    "check:astro": "astro check",
    "check:ts": "tsc --noEmit",
    "check:ts:tests": "tsc --project tsconfig.tests.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run format:check && npm run lint && npm run check:astro && npm run check:ts && npm run check:ts:tests && npm run test",
    "check:full": "npm run check && npm run test:e2e && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "invites:template": "node scripts/invitations/create-template.mjs",
    "invites:validate": "node scripts/invitations/validate.mjs",
    "invites:import": "node scripts/invitations/import.mjs",
    "invites:qr": "node scripts/invitations/generate-qr.mjs",
    "db:migrate": "netlify database migrations apply"
  },
  "dependencies": {
    "@astrojs/netlify": "^7.0.13",
    "@netlify/database": "^2.0.0",
    "astro": "^6.4.8",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/node": "^10.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "exceljs": "^4.4.0",
    "globals": "^16.0.0",
    "netlify-cli": "^27.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "qrcode": "^1.5.4",
    "read-excel-file": "^9.3.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "vite": "^7"
  }
}
